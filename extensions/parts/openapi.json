{
  "openapi": "3.1.0",
  "info": {
    "title": "parts",
    "version": "0.2.3",
    "description": "The routes the parts module serves. Every path is relative to the mount the host assigns, and the host serves this document rebased under it at <mount>/openapi.json."
  },
  "components": {
    "schemas": {
      "Folder": {
        "type": "object",
        "description": "One folder of the tree, with how much it holds directly. A folder holds folders and parts, and the tree starts at the top, folder 0.",
        "properties": {
          "v": {
            "type": "integer",
            "description": "The format of this record. It is 1."
          },
          "id": {
            "type": "integer",
            "description": "The number the module gave this folder. It is never given out twice."
          },
          "parent": {
            "type": "integer",
            "description": "The folder this one is in, and 0 for a folder at the top."
          },
          "name": {
            "type": "string",
            "description": "What the tree shows. Two folders in one parent never share a name, ignoring case."
          },
          "description": {
            "type": "string",
            "description": "A few lines a person wrote about what the folder holds."
          },
          "parts": {
            "type": "integer",
            "description": "How many parts are directly in this folder."
          },
          "folders": {
            "type": "integer",
            "description": "How many folders are directly in this folder."
          },
          "created": {
            "type": "string",
            "description": "When the folder was made.",
            "format": "date-time"
          },
          "changed": {
            "type": "string",
            "description": "When the folder was last changed.",
            "format": "date-time"
          },
          "changed_by": {
            "type": "string",
            "description": "The person the host named on the request that last changed it."
          }
        },
        "required": [
          "v",
          "id",
          "parent",
          "name",
          "created",
          "changed",
          "changed_by"
        ]
      },
      "FolderDraft": {
        "type": "object",
        "description": "What a caller sends to make or to change a folder. A field left out keeps what is stored. A new folder needs a name.",
        "properties": {
          "name": {
            "type": "string",
            "description": "What the tree shows. One line, at most 120 bytes, with no slash.",
            "maxLength": 120
          },
          "parent": {
            "type": "integer",
            "description": "The folder to put this one in, and 0 for the top. A folder cannot go into itself or into a folder inside it.",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "description": "A few lines about what the folder holds, at most 2 KiB.",
            "maxLength": 2048
          }
        }
      },
      "Picture": {
        "type": "object",
        "description": "The file a listing draws for a part.",
        "properties": {
          "storage": {
            "type": "string",
            "description": "The storage the file is in."
          },
          "path": {
            "type": "string",
            "description": "The file inside that storage."
          },
          "kind": {
            "type": "string",
            "description": "image is a picture file shown as it is. thumbnail is a print file with a picture inside it, which the core's thumbnail route serves.",
            "enum": [
              "image",
              "thumbnail"
            ]
          }
        },
        "required": [
          "storage",
          "path",
          "kind"
        ]
      },
      "Latest": {
        "type": "object",
        "description": "What a listing shows of a part's newest version.",
        "properties": {
          "number": {
            "type": "integer",
            "description": "The version number."
          },
          "files": {
            "type": "integer",
            "description": "How many files the version holds."
          },
          "bytes": {
            "type": "integer",
            "description": "What the files of the version add up to, in bytes."
          },
          "created": {
            "type": "string",
            "description": "When the version was written.",
            "format": "date-time"
          }
        },
        "required": [
          "number",
          "files",
          "bytes",
          "created"
        ]
      },
      "PartRow": {
        "type": "object",
        "description": "One part as a listing shows it, without its long text.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The number the module gave this part. It is never given out twice, so a link to a deleted part never opens another one."
          },
          "folder": {
            "type": "integer",
            "description": "The folder the part is in, and 0 for the top."
          },
          "name": {
            "type": "string",
            "description": "What the listing shows."
          },
          "summary": {
            "type": "string",
            "description": "The one line under the name."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The tags, sorted."
          },
          "versions": {
            "type": "integer",
            "description": "How many versions the part has."
          },
          "comments": {
            "type": "integer",
            "description": "How many comments are on the part."
          },
          "latest": {
            "$ref": "#/components/schemas/Latest"
          },
          "picture": {
            "$ref": "#/components/schemas/Picture"
          },
          "changed": {
            "type": "string",
            "description": "When the part or its newest version was last changed.",
            "format": "date-time"
          },
          "changed_by": {
            "type": "string",
            "description": "Who made that change."
          }
        },
        "required": [
          "id",
          "folder",
          "name",
          "tags",
          "versions",
          "comments",
          "changed",
          "changed_by"
        ]
      },
      "File": {
        "type": "object",
        "description": "One file of a version, in the storage the page uploaded it to. The size and the digest are what the storage reported when the version was written.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The last segment of the path, which is what a person reads."
          },
          "storage": {
            "type": "string",
            "description": "The storage the file is in."
          },
          "path": {
            "type": "string",
            "description": "The file inside that storage."
          },
          "size": {
            "type": "integer",
            "description": "The length in bytes."
          },
          "sha256": {
            "type": "string",
            "description": "The digest the storage took, and absent where it keeps none."
          },
          "thumbnail": {
            "type": "boolean",
            "description": "Whether the storage reported a picture inside the file when the version was written. false means it has none, and absent means the storage did not say."
          }
        },
        "required": [
          "name",
          "storage",
          "path",
          "size"
        ]
      },
      "Version": {
        "type": "object",
        "description": "One state of a part: the files it was at, and a note on what changed. The files of a version do not change.",
        "properties": {
          "v": {
            "type": "integer",
            "description": "The format of this record. It is 1."
          },
          "part": {
            "type": "integer",
            "description": "The part this version belongs to."
          },
          "number": {
            "type": "integer",
            "description": "Counts the versions of one part from 1."
          },
          "note": {
            "type": "string",
            "description": "What a person wrote about this version."
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "description": "The files of this version, in the order they were sent."
          },
          "created": {
            "type": "string",
            "description": "When the version was written.",
            "format": "date-time"
          },
          "created_by": {
            "type": "string",
            "description": "Who wrote it."
          },
          "changed": {
            "type": "string",
            "description": "When its note was last changed.",
            "format": "date-time"
          },
          "changed_by": {
            "type": "string",
            "description": "Who changed the note last."
          }
        },
        "required": [
          "v",
          "part",
          "number",
          "files",
          "created",
          "created_by",
          "changed",
          "changed_by"
        ]
      },
      "Comment": {
        "type": "object",
        "description": "One note a person left on a part. Only the person who wrote it may change it.",
        "properties": {
          "v": {
            "type": "integer",
            "description": "The format of this record. It is 1."
          },
          "id": {
            "type": "integer",
            "description": "The number the module gave this comment."
          },
          "part": {
            "type": "integer",
            "description": "The part the comment is on."
          },
          "body": {
            "type": "string",
            "description": "What the person wrote."
          },
          "by": {
            "type": "string",
            "description": "The person the host named when the comment was written."
          },
          "created": {
            "type": "string",
            "description": "When it was written.",
            "format": "date-time"
          },
          "edited": {
            "type": "string",
            "description": "When the body was last changed, and absent for a comment never changed.",
            "format": "date-time"
          }
        },
        "required": [
          "v",
          "id",
          "part",
          "body",
          "by",
          "created"
        ]
      },
      "PartDetail": {
        "type": "object",
        "description": "One part with everything its own page draws: the long text, every version and every comment.",
        "properties": {
          "v": {
            "type": "integer",
            "description": "The format of this record. It is 1."
          },
          "id": {
            "type": "integer",
            "description": "The number the module gave this part."
          },
          "folder": {
            "type": "integer",
            "description": "The folder the part is in, and 0 for the top."
          },
          "name": {
            "type": "string",
            "description": "What a listing shows."
          },
          "summary": {
            "type": "string",
            "description": "The one line under the name."
          },
          "description": {
            "type": "string",
            "description": "The long text a person edits."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The tags, sorted."
          },
          "cover": {
            "type": "string",
            "description": "The path of the file a person chose to stand for the part, and absent when the module chooses."
          },
          "last_version": {
            "type": "integer",
            "description": "The highest version number the part ever gave out, also one since deleted. The next version takes a higher one. Absent for a part that never had a version."
          },
          "created": {
            "type": "string",
            "description": "When the part was made.",
            "format": "date-time"
          },
          "created_by": {
            "type": "string",
            "description": "Who made it."
          },
          "changed": {
            "type": "string",
            "description": "When the part was last changed.",
            "format": "date-time"
          },
          "changed_by": {
            "type": "string",
            "description": "Who changed it last."
          },
          "revision": {
            "type": "integer",
            "description": "The version of the record. A change that sends it back is refused with parts/CHANGED when somebody else changed the part first."
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Version"
            },
            "description": "Every version, the oldest first."
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            },
            "description": "Every comment, the oldest first."
          },
          "picture": {
            "$ref": "#/components/schemas/Picture"
          },
          "dir": {
            "type": "string",
            "description": "The folder in the storage this part's new files are uploaded under, as <dir>/<upload>/<file name>."
          },
          "storage": {
            "type": "string",
            "description": "The storage new files are uploaded to."
          }
        },
        "required": [
          "v",
          "id",
          "folder",
          "name",
          "tags",
          "created",
          "created_by",
          "changed",
          "changed_by",
          "revision",
          "versions",
          "comments",
          "dir",
          "storage"
        ]
      },
      "PartDraft": {
        "type": "object",
        "description": "What a caller sends to make or to change a part. A field left out keeps what is stored, and a field sent empty clears it. A new part needs a name.",
        "properties": {
          "name": {
            "type": "string",
            "description": "What a listing shows. One line, at most 120 bytes.",
            "maxLength": 120
          },
          "folder": {
            "type": "integer",
            "description": "The folder to put the part in, and 0 for the top.",
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "description": "The one line under the name, at most 280 bytes.",
            "maxLength": 280
          },
          "description": {
            "type": "string",
            "description": "The long text, at most 16 KiB. Line breaks are kept.",
            "maxLength": 16384
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            },
            "maxItems": 16,
            "description": "Lower-case letters and digits joined by hyphens. They are lower-cased, sorted, and a repeat is dropped."
          },
          "cover": {
            "type": "string",
            "description": "The path of one of the part's files to stand for the part. Empty lets the module choose."
          },
          "revision": {
            "type": "integer",
            "description": "The revision the caller read. When it is sent and somebody changed the part since, the change is refused with parts/CHANGED."
          }
        }
      },
      "FileDraft": {
        "type": "object",
        "description": "One file a new version holds. A file just uploaded leaves the storage out and is in <dir>/<upload>/<file name> of the part. A file kept from an earlier version is sent with the storage and the path that version recorded.",
        "properties": {
          "storage": {
            "type": "string",
            "description": "The storage the file is in. Left out, it is the storage the module's settings name."
          },
          "path": {
            "type": "string",
            "description": "The file inside that storage."
          }
        },
        "required": [
          "path"
        ]
      },
      "VersionDraft": {
        "type": "object",
        "description": "What a caller sends to add a version. The module asks the storage for each file, as the caller, and records the size and the digest the storage reports.",
        "properties": {
          "note": {
            "type": "string",
            "description": "What changed in this version, at most 2 KiB.",
            "maxLength": 2048
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileDraft"
            },
            "minItems": 1,
            "maxItems": 32,
            "description": "The files of the version, at least one and at most 32."
          }
        },
        "required": [
          "files"
        ]
      },
      "Tag": {
        "type": "object",
        "description": "One tag and how many parts carry it.",
        "properties": {
          "tag": {
            "type": "string",
            "description": "The tag."
          },
          "parts": {
            "type": "integer",
            "description": "How many parts carry it."
          }
        },
        "required": [
          "tag",
          "parts"
        ]
      },
      "Usage": {
        "type": "object",
        "description": "What the catalogue's own database takes. The database is bounded by the disk or by its Postgres server, so the limit is zero.",
        "properties": {
          "bytes": {
            "type": "integer",
            "description": "The bytes the database takes, and zero when its engine cannot say."
          },
          "limit": {
            "type": "integer",
            "description": "The bytes the catalogue may take, and zero for no limit."
          }
        },
        "required": [
          "bytes",
          "limit"
        ]
      },
      "Removed": {
        "type": "object",
        "description": "What a delete leaves for the page to clean up in the storage. The module records files and never deletes one, because deleting a file takes write_storage, which the person holds and the module does not.",
        "properties": {
          "storage": {
            "type": "string",
            "description": "The storage new files go into, and the storage dir is in."
          },
          "dir": {
            "type": "string",
            "description": "The part's whole folder in storage, set when the part itself was deleted and every folder it used is this one. Empty when its files sit in several folders, which dirs then names."
          },
          "dirs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StorageDir"
            },
            "description": "Every folder the deleted part's files were kept in, each in its own storage, with the folder new files go into first. Empty when one version was deleted."
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "description": "The files no remaining version names. When a part was deleted these are every file it recorded."
          }
        },
        "required": [
          "storage",
          "dirs",
          "files"
        ]
      },
      "StorageDir": {
        "type": "object",
        "description": "One folder in one storage.",
        "properties": {
          "storage": {
            "type": "string",
            "description": "The storage the folder is in."
          },
          "dir": {
            "type": "string",
            "description": "The folder inside that storage."
          }
        },
        "required": [
          "storage",
          "dir"
        ]
      },
      "PartAnswer": {
        "type": "object",
        "description": "One part, and the person the host authorized.",
        "properties": {
          "part": {
            "$ref": "#/components/schemas/PartDetail"
          },
          "principal": {
            "type": "string",
            "description": "Who the host says is calling."
          }
        },
        "required": [
          "part",
          "principal"
        ]
      },
      "FolderAnswer": {
        "type": "object",
        "description": "One folder, and the person the host authorized.",
        "properties": {
          "folder": {
            "$ref": "#/components/schemas/Folder"
          },
          "principal": {
            "type": "string",
            "description": "Who the host says is calling."
          }
        },
        "required": [
          "folder",
          "principal"
        ]
      },
      "CommentAnswer": {
        "type": "object",
        "description": "One comment, and the person the host authorized.",
        "properties": {
          "comment": {
            "$ref": "#/components/schemas/Comment"
          },
          "principal": {
            "type": "string",
            "description": "Who the host says is calling."
          }
        },
        "required": [
          "comment",
          "principal"
        ]
      },
      "Deleted": {
        "type": "object",
        "description": "The id of what was deleted, and the person the host authorized.",
        "properties": {
          "deleted": {
            "type": "integer",
            "description": "The id of the folder or the comment that is gone."
          },
          "principal": {
            "type": "string",
            "description": "Who the host says is calling."
          }
        },
        "required": [
          "deleted",
          "principal"
        ]
      },
      "Refusal": {
        "type": "object",
        "description": "One refusal, as RFC 9457 names it. The client SDK reads this shape: code reaches ApiError.code and detail reaches ApiError.message.",
        "properties": {
          "type": {
            "type": "string",
            "description": "about:blank, because this module publishes no page per code."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status, repeated in the body."
          },
          "code": {
            "type": "string",
            "description": "The module's own code. It is outside the core's registry, so it starts with the module's short name.",
            "enum": [
              "parts/BODY_TOO_LARGE",
              "parts/CHANGED",
              "parts/COMMENT_NOT_FOUND",
              "parts/FILE_MISSING",
              "parts/FOLDER_NOT_EMPTY",
              "parts/FOLDER_NOT_FOUND",
              "parts/FULL",
              "parts/INVALID",
              "parts/INVALID_QUERY",
              "parts/NAME_TAKEN",
              "parts/NOT_AUTHOR",
              "parts/NO_PRINCIPAL",
              "parts/PART_NOT_FOUND",
              "parts/STORE_FAILED",
              "parts/VERSION_NOT_FOUND"
            ]
          },
          "title": {
            "type": "string",
            "description": "What went wrong, in one English phrase that never varies."
          },
          "detail": {
            "type": "string",
            "description": "What went wrong this time, naming the field and the limit."
          },
          "params": {
            "type": "object",
            "additionalProperties": true,
            "description": "What the code fills in."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether sending the same request again could work."
          }
        },
        "required": [
          "type",
          "status",
          "code",
          "title",
          "detail",
          "params",
          "retryable"
        ]
      }
    },
    "responses": {
      "Refused": {
        "description": "The module refused the call. The code says which rule it met.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Refusal"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/overview": {
      "get": {
        "operationId": "read-overview",
        "summary": "The folder tree, the tags and the room left",
        "description": "Every folder with how much it holds, every tag with how many parts carry it, what the catalogue's database takes, and the storage and folder new files go into. One call frames the whole catalogue screen. The host takes view_resource on the module's instance before this is called.",
        "responses": {
          "200": {
            "description": "The catalogue as one screen frames it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The catalogue's frame.",
                  "properties": {
                    "folders": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Folder"
                      },
                      "description": "Every folder, ordered by parent and then by name."
                    },
                    "root_parts": {
                      "type": "integer",
                      "description": "How many parts are at the top, in no folder."
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tag"
                      },
                      "description": "Every tag in use, the most used first."
                    },
                    "usage": {
                      "$ref": "#/components/schemas/Usage"
                    },
                    "storage": {
                      "type": "string",
                      "description": "The storage new files go into."
                    },
                    "root": {
                      "type": "string",
                      "description": "The folder in that storage the files go under."
                    },
                    "principal": {
                      "type": "string",
                      "description": "Who the host says is calling."
                    }
                  },
                  "required": [
                    "folders",
                    "root_parts",
                    "tags",
                    "usage",
                    "storage",
                    "root",
                    "principal"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/folders": {
      "post": {
        "operationId": "create-folder",
        "summary": "Make a folder",
        "description": "Writes one new folder under a parent, or at the top. A name its parent already holds is refused with parts/NAME_TAKEN. The host takes operate_resource on the module's instance before this is called.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderDraft"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The folder that was made.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderAnswer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/folders/{id}": {
      "patch": {
        "operationId": "change-folder",
        "summary": "Rename, move or describe a folder",
        "description": "Writes the fields the draft carries. A new parent moves the folder with everything in it. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The folder's id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The folder as it is now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderAnswer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      },
      "delete": {
        "operationId": "delete-folder",
        "summary": "Delete an empty folder",
        "description": "Removes a folder that holds no folder and no part. One that holds something is refused with parts/FOLDER_NOT_EMPTY rather than emptied. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The folder's id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The id of the folder that is gone.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deleted"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/parts": {
      "get": {
        "operationId": "list-parts",
        "summary": "One page of the parts that match",
        "description": "The parts that match the query, by name or by the newest change, one page at a time. The host takes view_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "folder",
            "in": "query",
            "description": "Keep the parts in one folder, and 0 for the top. Absent keeps every folder.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "deep",
            "in": "query",
            "description": "With folder, also keep the parts in every folder under it.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Keep the parts whose name, summary, description, tags or file names hold this, ignoring case.",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Keep the parts that carry this tag.",
            "schema": {
              "type": "string",
              "maxLength": 32
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "name, the default, or changed, which puts the newest change first.",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "changed"
              ]
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "How many matching parts to skip.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many parts to answer, at most 200, which is also the default.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the parts that match.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "One page.",
                  "properties": {
                    "parts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PartRow"
                      },
                      "description": "The page."
                    },
                    "matched": {
                      "type": "integer",
                      "description": "How many parts the query kept, over every page."
                    },
                    "held": {
                      "type": "integer",
                      "description": "How many parts the catalogue holds."
                    },
                    "principal": {
                      "type": "string",
                      "description": "Who the host says is calling."
                    }
                  },
                  "required": [
                    "parts",
                    "matched",
                    "held",
                    "principal"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      },
      "post": {
        "operationId": "create-part",
        "summary": "Add a part",
        "description": "Writes one new part with no version yet. Its files are added as its first version. The host takes operate_resource on the module's instance before this is called.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartDraft"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The part that was made.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartAnswer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/parts/{id}": {
      "get": {
        "operationId": "get-part",
        "summary": "One part, with its versions and comments",
        "description": "Everything a part's own page draws. The host takes view_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The part's id.",
