              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartAnswer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      },
      "patch": {
        "operationId": "change-part",
        "summary": "Change a part",
        "description": "Writes the fields the draft carries. A draft that carries the revision it was made against is refused with parts/CHANGED when somebody else changed the part since. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The part's id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The part as it is now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartAnswer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      },
      "delete": {
        "operationId": "delete-part",
        "summary": "Delete a part",
        "description": "Removes the part with its versions and its comments, and answers the folder in the storage its files are in, for the page to delete. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The part's id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "What the page deletes from the storage.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "A deleted part.",
                  "properties": {
                    "removed": {
                      "$ref": "#/components/schemas/Removed"
                    },
                    "principal": {
                      "type": "string",
                      "description": "Who the host says is calling."
                    }
                  },
                  "required": [
                    "removed",
                    "principal"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/parts/{id}/versions": {
      "post": {
        "operationId": "create-version",
        "summary": "Add a version",
        "description": "Writes a new version of the part with the files the draft names. Each file is looked up in the storage as the caller first, and one that is not there is refused with parts/FILE_MISSING. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The part's id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VersionDraft"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The part with its new version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartAnswer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/parts/{id}/versions/{number}": {
      "patch": {
        "operationId": "change-version",
        "summary": "Rewrite a version's note",
        "description": "The files of a version do not change. A different set of files is a new version. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The part's id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "description": "The version number.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "A version's note.",
                "properties": {
                  "note": {
                    "type": "string",
                    "description": "What changed in this version, at most 2 KiB.",
                    "maxLength": 2048
                  }
                },
                "required": [
                  "note"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The part as it is now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartAnswer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      },
      "delete": {
        "operationId": "delete-version",
        "summary": "Delete a version",
        "description": "Removes one version, and answers the files no other version of the part names, for the page to delete. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The part's id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "description": "The version number.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "What the page deletes from the storage, and the part as it is now.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "A deleted version.",
                  "properties": {
                    "removed": {
                      "$ref": "#/components/schemas/Removed"
                    },
                    "part": {
                      "$ref": "#/components/schemas/PartDetail"
                    },
                    "principal": {
                      "type": "string",
                      "description": "Who the host says is calling."
                    }
                  },
                  "required": [
                    "removed",
                    "part",
                    "principal"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/parts/{id}/comments": {
      "post": {
        "operationId": "create-comment",
        "summary": "Write a comment",
        "description": "Writes one comment on the part, as the caller. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "id",
